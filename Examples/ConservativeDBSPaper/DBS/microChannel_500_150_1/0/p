FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    leftFace
    {
        type    fixedValue;
        value   uniform 0.01;
    }

    rightFace
    {
        type    fixedValue;
        value   uniform 0;
    }

    leftPorous
    {
        type    fixedValue;
        value   uniform 0;
    }

    rightPorous
    {
        type    fixedValue;
        value   uniform 0;
    }

    bottom
    {
        type    zeroGradient;
    }

    top
    {
        type    zeroGradient;
    }

    frontAndBack
    {
        type    empty;
    }
}
